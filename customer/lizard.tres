likes_deep = 0.9
lines = Dictionary[String, PackedStringArray]({
"after": PackedStringArray("We should do inventory more often.", "I can\'t feel my tail. Worth it."),
"all_in": PackedStringArray("ALL of it?! ...Okay. OKAY.", "Every inch! I salute you, captain!"),
"angry_stop": PackedStringArray("Okay, I\'m done! Shoo!", "Nope! Out! Ship\'s closed!"),
"ask_no": PackedStringArray("Not tonight! Next tide, maybe.", "Nope! Ask me later!"),
"ask_yes": PackedStringArray("...Okay. Yes! Go slow there.", "Aye aye. Carefully!"),
"deep": PackedStringArray("Whoa, DEEP! Keep it there!", "Oh that\'s DEEP. Yes!"),
"edge": PackedStringArray("Where are you gonna... decide fast!"),
"forced": PackedStringArray("OW! I said NO!", "Stop! That HURTS, you jerk!"),
"futa_after": PackedStringArray("Now we BOTH need a mop.", "Best inventory ever. Both of us."),
"futa_her_cum": PackedStringArray("AHH! I\'m firing BOTH barrels!", "Whoa, it\'s going everywhere! Sorry, deck!"),
"futa_start": PackedStringArray("Surprise! I\'ve got a little extra. Back door only tonight!", "Don\'t mind the cannon. Ahoy back there!"),
"good": PackedStringArray("THAT\'S the stuff!", "You\'re hired. By me."),
"her_cum": PackedStringArray("AHHH! OHHH! ...Wow.", "I\'m gonna... CAPSIZE! AHH!"),
"insert": PackedStringArray("OH. Hi! Hello!", "Ahoy! ...Sorry. Reflex."),
"inside": PackedStringArray("OHHH. That\'s the stuff!", "Yes! Fill the hold!"),
"left_early": PackedStringArray("You\'re LEAVING? Now?!", "Did I do something wrong?"),
"not_yet": PackedStringArray("Already?! I was SO close!", "Hey! I didn\'t get to finish!"),
"outside": PackedStringArray("Aww. All over my scales?", "Hey! I wanted that!"),
"pushed": PackedStringArray("I SAID NO. Don\'t make me bite!"),
"respected": PackedStringArray("You listened. That\'s really nice.\n...Forget I said that."),
"slap": PackedStringArray("WHOA! Again!", "Aye, captain!"),
"slap_red": PackedStringArray("Handprint for a week!"),
"slip": PackedStringArray("You fell out! Get back here!", "Man overboard!"),
"stage_1": PackedStringArray("Faster, sailor!", "Yes! Full steam!"),
"stage_2": PackedStringArray("Don\'t you DARE slow down!", "This beats shells!"),
"stage_3": PackedStringArray("I\'m gonna capsize!", "Keep going keep going!"),
"start": PackedStringArray("Ahoy back there! ...Is the door locked?", "Okay! I\'m ready! Probably!"),
"too_deep": PackedStringArray("Easy! That\'s the bottom!"),
"too_fast": PackedStringArray("Whoa! I\'m not a bilge pump!", "Storm warning! Easy!"),
"too_slow": PackedStringArray("Are we docking or sinking?", "Hello? Did you fall asleep?"),
"wrong_hole": PackedStringArray("WHOA. Wrong door, captain!", "Ask first! It\'s polite!")
})

[sub_resource type="Resource" id="Set_crab"]
script = ExtResource("4")
lines = PackedStringArray("Ahoy again! I\'m back! Did you miss me? Say yes.", "I fought a crab today. The crab won.", "...You\'d have saved me, right? Right?")
order_line = "Beer! For my wounds!"

[sub_resource type="Resource" id="Set_boot"]
script = ExtResource("4")
lines = PackedStringArray("Guess what. GUESS.", "I found a boot in the harbor! Fits perfect.", "Like us! ...Forget I said that.", "There was a fish in it too. I kept him.")
order_line = "One beer! The fish doesn't drink."

[sub_resource type="Resource" id="Set_shells"]
script = ExtResource("4")
lines = PackedStringArray("Is the big guy back yet? No? Good.", "More of you for me!", "I told him I\'d pay him back in shells. He said RUDE things.")
order_line = "Beer me! I'll pay in shells! Or a kiss! ...Shells!"

[sub_resource type="Resource" id="Set_messi"]
script = ExtResource("4")
lines = PackedStringArray("I saw MESSI at the docks today!", "...It was a seagull in a little shirt.", "You\'re cuter than Messi though. Don\'t tell Messi.")
order_line = "A beer! To celebrate Messi!"

