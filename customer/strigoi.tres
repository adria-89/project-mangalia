[sub_resource type="Resource" id="Set_returned"]
script = ExtResource("4")
lines = PackedStringArray("M-mortal! I have RETURNED!", "...Was that too loud? That was too loud. Sorry.")
order_line = "The usual, please. The d-dark one. Cola."

[sub_resource type="Resource" id="Set_lighthouse"]
script = ExtResource("4")
lines = PackedStringArray("I tried to haunt the lighthouse last night.", "The keeper made me tea.", "...It was very nice tea.")
order_line = "Cola, please. Fizzy. Like my... um. My soul."

[sub_resource type="Resource" id="Set_holy_water"]
script = ExtResource("4")
lines = PackedStringArray("D-do you know why I can't drink rum on its own?", "It burns. Like holy water.", "Hidden in cola it's fine. Cola protects me.")
order_line = "Just cola tonight. N-no rum. Could you check? Twice?"

[sub_resource type="Resource" id="Set_striggy"]
script = ExtResource("4")
lines = PackedStringArray("The other girls call me Striggy now.", "I'm supposed to be t-terrifying...", "...I don't hate it.")
order_line = "A cola, please, bartender. Er. M-mortal."

[sub_resource type="Resource" id="Set_seagull"]
script = ExtResource("4")
lines = PackedStringArray("I hissed at a seagull today.", "It hissed back.", "We're f-friends now. I think?")
order_line = "One cola, please. For me. N-not the seagull."

